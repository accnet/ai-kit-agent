{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://starterkit.local/contracts/block-definitions/v1.schema.json",
  "title": "Builder block definitions response v1",
  "description": "Capability-protected client projection returned by GET /wp-json/starterkit/v1/blocks.",
  "type": "object",
  "required": ["blocks"],
  "properties": {
    "blocks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/blockDefinition"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "blockDefinition": {
      "type": "object",
      "required": ["label", "settingsSchema", "defaults", "allowed_sections", "inserter"],
      "properties": {
        "label": { "type": "string" },
        "settingsSchema": {
          "type": "array",
          "items": { "type": "object" }
        },
        "defaults": { "type": "object" },
        "allowed_sections": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "anyOf": [
              { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$" },
              { "const": "*" }
            ]
          }
        },
        "inserter": { "type": "boolean" }
      },
      "additionalProperties": false
    }
  }
}
